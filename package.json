{
  "name": "@firefly/ai-engine",
  "private": true,
  "version": "1.0.0",
  "description": "Standalone on-device AI inference engine & model management platform for Firefly AI Folder (Tauri 2 + React 19 + llama.cpp)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leonard-Li777/firefly-ai-engine.git"
  },
  "homepage": "https://github.com/Leonard-Li777/firefly-ai-engine",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.js vite",
    "dev:ui": "node scripts/run.js vite",
    "dev:tauri": "cargo tauri dev",
    "build": "tsc && node scripts/run.js vite build",
    "preview": "node scripts/run.js vite preview",
    "test": "node scripts/run.js vitest run",
    "test:watch": "node scripts/run.js vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@firefly/shared": "workspace:*",
    "@firefly/types": "workspace:*",
    "@radix-ui/react-slot": "1.1.2",
